# -----------------------------------------------------------------------------
# Auth (used by app/core/security.py and api/routes/auth.py)
# -----------------------------------------------------------------------------

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# Seven days. Set a shorter value only when the deployment's security policy requires it.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Database
# Local:  sqlite (no install) or postgresql://user:pass@localhost:5432/dbname
# AWS:    use the external URL from RDS (or Render) - postgresql://...
# -----------------------------------------------------------------------------

# On Render, DATABASE_URL is the internal host (dpg-…-a). That hostname does
# NOT resolve on your laptop — put the external URL in DATABASE_URL_EXT and
# leave DATABASE_URL as Render gave it (or point DATABASE_URL at local Postgres).
DATABASE_URL=postgresql://user:password@localhost:5432/pdfgenerator
# DATABASE_URL_EXT=postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname

# -----------------------------------------------------------------------------
# CORS – comma-separated frontend origins (no spaces)
# Local:  http://localhost:5173
# Prod:   https://pdf-generator-react.onrender.com (and localhost if you test against prod API)
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,https://pdf-generator-react.onrender.com

# -----------------------------------------------------------------------------
# AWS S3 (optional – leave empty for local file storage)
# Local:  leave S3_BUCKET_NAME empty to use static/generated and uploads/
# AWS:    set bucket + credentials so PDFs/images go to S3
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=your-AWS-key-here
AWS_SECRET_ACCESS_KEY=your-AWS-secret-access-key-here
AWS_REGION=region
S3_BUCKET_NAME=S3-bucket-name

# -----------------------------------------------------------------------------
# OpenAI (AI extract + Asystent AI)
# 1 AI credit = 5 groszy (0.05 PLN). Charged via ceil(cost_pln / 0.05), min 1.
# -----------------------------------------------------------------------------

# API_GPT_KEY=sk-...
# AI_ASSISTANT_MODEL=gpt-5.4-mini
# Layout (Układ) defaults to the cost-efficient Luna model — override if needed:
# AI_LAYOUT_MODEL=gpt-5.6-luna
# Reasoning effort for Układ (default medium; high burns budget on full A4 JSON):
# AI_LAYOUT_REASONING_EFFORT=medium
# Fast mode for Układ (~2× Luna token rates). Use default/standard to disable:
# AI_LAYOUT_SERVICE_TIER=fast
# Completion budget for Układ (includes hidden reasoning tokens). Default 48000.
# AI_LAYOUT_MAX_COMPLETION_TOKENS=48000
# USD_TO_PLN=4.0
# Optional ops secret for POST /billing/admin/reset-ai-credits (else SECRET_KEY):
# ADMIN_RESET_SECRET=

