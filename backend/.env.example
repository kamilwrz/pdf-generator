# -----------------------------------------------------------------------------
# Auth (used by app/core/security.py and api/routes/auth.py)
# -----------------------------------------------------------------------------

# At least 16 characters. Placeholders like "your-secret-key-here" are rejected at boot.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Seven days. Set a shorter value only when the deployment's security policy requires it.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local throwaway only — never set in production:
# ALLOW_INSECURE_SECRET=true

# -----------------------------------------------------------------------------
# Database
# Local:  sqlite (no install) or postgresql://user:pass@localhost:5432/dbname
# AWS:    use the external URL from RDS (or Render) - postgresql://...
# -----------------------------------------------------------------------------

# On Render, DATABASE_URL is the internal host (dpg-…-a). That hostname does
# NOT resolve on your laptop — put the external URL in DATABASE_URL_EXT and
# leave DATABASE_URL as Render gave it (or point DATABASE_URL at local Postgres).
DATABASE_URL=postgresql://user:password@localhost:5432/pdfgenerator
# DATABASE_URL_EXT=postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname

# -----------------------------------------------------------------------------
# CORS – comma-separated frontend origins (no spaces)
# Local:  http://localhost:5173
# Prod:   https://pdf-generator-react.onrender.com (and localhost if you test against prod API)
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,https://pdf-generator-react.onrender.com

# -----------------------------------------------------------------------------
# AWS S3 (optional – leave empty for local file storage)
# Local:  leave S3_BUCKET_NAME empty to use static/generated and uploads/
# AWS:    set bucket + credentials so PDFs/images go to S3
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=your-AWS-key-here
AWS_SECRET_ACCESS_KEY=your-AWS-secret-access-key-here
AWS_REGION=region
S3_BUCKET_NAME=S3-bucket-name

# -----------------------------------------------------------------------------
# Cloudflare Workers AI (PDF CV import)
# Create a token with Workers AI Read + Edit. Never expose it to the frontend.
# Native-text imports use Gemma with thinking disabled for low latency. Invalid,
# empty, or model-capacity output gets one same-provider JSON-mode Llama fallback.
# Scanned pages switch to Qwen vision.
# -----------------------------------------------------------------------------

CV_EXTRACT_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-your-workers-ai-token
CLOUDFLARE_TEXT_MODEL=@cf/google/gemma-4-26b-a4b-it
# Used once when the primary is empty, invalid, non-normalisable, or at capacity:
CLOUDFLARE_TEXT_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Keep false for normal CV schema extraction. Set true only for controlled
# quality experiments; the effort setting below applies only when enabled.
CLOUDFLARE_TEXT_ENABLE_THINKING=false
CLOUDFLARE_TEXT_REASONING_EFFORT=low
CLOUDFLARE_VISION_MODEL=@cf/qwen/qwen3.8-27b
# PDF pages accepted by the extractor (the upload route also enforces this cap):
CV_EXTRACT_MAX_PAGES=12
# A shorter native text layer triggers vision OCR for that page:
CV_EXTRACT_MIN_TEXT_CHARS_PER_PAGE=80
# Upper bound for the final JSON of unusually long native-text CVs:
CV_EXTRACT_TEXT_MAX_COMPLETION_TOKENS=32000
# Non-reasoning JSON fallback and explicit OpenAI rollback:
CV_EXTRACT_JSON_MAX_COMPLETION_TOKENS=8000
CV_EXTRACT_VISION_MAX_COMPLETION_TOKENS=8000
# Legacy shared override. Leave unset unless both modes intentionally use one cap:
# CV_EXTRACT_MAX_COMPLETION_TOKENS=8000

# -----------------------------------------------------------------------------
# OpenAI (Asystent AI and optional CV-import rollback provider)
# 1 AI credit = 5 groszy (0.05 PLN). Charged via ceil(cost_pln / 0.05), min 1.
# -----------------------------------------------------------------------------

# API_GPT_KEY=sk-...
# To temporarily route CV imports back to OpenAI:
# CV_EXTRACT_PROVIDER=openai
# CV_EXTRACT_OPENAI_MODEL=gpt-4o
# AI_ASSISTANT_MODEL=gpt-5.4-mini
# Layout (Układ) defaults to the cost-efficient Luna model — override if needed:
# AI_LAYOUT_MODEL=gpt-5.6-luna
# Reasoning effort for Układ (default high = Luna max; none/low/medium/high):
# AI_LAYOUT_REASONING_EFFORT=high
# Fast mode for Układ (~2× Luna token rates). Use default/standard to disable:
# AI_LAYOUT_SERVICE_TIER=fast
# Completion budget for Układ (includes hidden reasoning tokens). Default 48000.
# AI_LAYOUT_MAX_COMPLETION_TOKENS=48000
# USD_TO_PLN=4.0
# Pre-Stripe: set true locally so Standard/Premium can be activated without Checkout.
# Defaults to false (safe for production).
ALLOW_UNPAID_PLAN_SELECTION=true

# Required for POST /billing/admin/reset-ai-credits (does not fall back to SECRET_KEY):
# ADMIN_RESET_SECRET=replace-with-a-separate-ops-secret

