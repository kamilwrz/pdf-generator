# -----------------------------------------------------------------------------
# Auth (used by app/core/security.py and api/routes/auth.py)
# -----------------------------------------------------------------------------

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# Seven days. Set a shorter value only when the deployment's security policy requires it.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Database
# Local:  sqlite (no install) or postgresql://user:pass@localhost:5432/dbname
# AWS:    use the external URL from RDS (or Render) - postgresql://...
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@localhost:5432/pdfgenerator

# -----------------------------------------------------------------------------
# CORS – comma-separated frontend origins (no spaces)
# Local:  http://localhost:5173
# AWS:    https://your-frontend-domain.com (and add http://localhost:5173 if you test from local frontend)
# -----------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# AWS S3 (optional – leave empty for local file storage)
# Local:  leave S3_BUCKET_NAME empty to use static/generated and uploads/
# AWS:    set bucket + credentials so PDFs/images go to S3
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=your-AWS-key-here
AWS_SECRET_ACCESS_KEY=your-AWS-secret-access-key-here
AWS_REGION=region
S3_BUCKET_NAME=S3-bucket-name 
