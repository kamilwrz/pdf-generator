# Optional in development. When omitted, Vite proxies `/api` to localhost:8000.
# Production builds must provide an explicit HTTPS VITE_API_URL.
# VITE_API_URL=http://localhost:8000
# Optional development-only proxy target:
# VITE_DEV_API_TARGET=http://localhost:8000
# Public Google Identity Services OAuth Web client id. Must match the backend
# GOOGLE_CLIENT_ID audience configuration.
# VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
